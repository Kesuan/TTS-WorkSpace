#!/usr/bin/env bash
# TTS-WorkSpace 静态检查：cargo fmt + clippy（ui/ 存在时追加前端 lint）
#
# 退出码：0 通过 · 1 检查失败 · 2 内部错误
set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT" || exit 2

if ! command -v cargo >/dev/null 2>&1; then
  echo "错误：未找到 cargo（需要 Rust 工具链，见 README）" >&2
  exit 2
fi

echo "==> cargo fmt --check"
if ! cargo fmt --all -- --check; then
  echo "==> 格式检查失败：运行 \`cargo fmt --all\` 修复"
  exit 1
fi

echo "==> cargo clippy（warnings 视为错误）"
if ! cargo clippy --workspace --all-targets -- -D warnings; then
  echo "==> clippy 未通过"
  exit 1
fi

if [[ -f ui/package.json ]] && command -v npm >/dev/null 2>&1; then
  echo "==> 前端 lint"
  (cd ui && npm run --silent lint) || exit 1
fi

echo "==> lint 通过"
exit 0
