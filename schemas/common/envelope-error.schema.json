{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tts-workspace.dev/schemas/common/envelope-error.schema.json",
  "title": "失败信封（tts --json 出错时的 stdout 结构）",
  "type": "object",
  "required": ["ok", "error"],
  "properties": {
    "ok": { "const": false },
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^E_[A-Z0-9_]+$",
          "description": "错误码，见 docs/cli.md 错误码表"
        },
        "message": { "type": "string", "minLength": 1 },
        "hint": { "type": "string" },
        "details": { "type": "object" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
