{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tts-workspace.dev/schemas/cli/takes-select.schema.json",
  "title": "tts takes select --json 成功输出",
  "type": "object",
  "required": ["ok", "data"],
  "properties": {
    "ok": { "const": true },
    "data": {
      "type": "object",
      "required": ["project", "line_id", "take_id", "previous_selected"],
      "properties": {
        "project": { "type": "string", "minLength": 1 },
        "line_id": { "type": "string", "minLength": 1 },
        "take_id": { "type": "string", "minLength": 1 },
        "previous_selected": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
