{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tts-workspace.dev/schemas/cli/batch-retry.schema.json",
  "title": "tts batch retry --json 成功输出",
  "type": "object",
  "required": ["ok", "data"],
  "properties": {
    "ok": { "const": true },
    "data": {
      "type": "object",
      "required": ["project", "reset", "line_ids"],
      "properties": {
        "project": { "type": "string", "minLength": 1 },
        "reset": { "type": "integer", "minimum": 0 },
        "line_ids": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
