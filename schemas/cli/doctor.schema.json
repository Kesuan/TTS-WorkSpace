{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tts-workspace.dev/schemas/cli/doctor.schema.json",
  "title": "tts doctor --json 成功输出",
  "type": "object",
  "required": ["ok", "data"],
  "properties": {
    "ok": { "const": true },
    "data": {
      "type": "object",
      "required": ["version", "workspace_root", "config_path", "checks", "summary"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "workspace_root": { "type": "string", "minLength": 1 },
        "config_path": { "type": "string", "minLength": 1 },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "status", "detail"],
            "properties": {
              "name": { "enum": ["workspace", "config", "api_key", "ffmpeg", "network"] },
              "status": { "enum": ["ok", "warn", "fail", "skipped"] },
              "detail": { "type": "string" },
              "hint": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "summary": {
          "type": "object",
          "required": ["ok", "warn", "fail", "skipped"],
          "properties": {
            "ok": { "type": "integer", "minimum": 0 },
            "warn": { "type": "integer", "minimum": 0 },
            "fail": { "type": "integer", "minimum": 0 },
            "skipped": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
