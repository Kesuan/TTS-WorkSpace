{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tts-workspace.dev/schemas/cli/version.schema.json",
  "title": "tts version --json 成功输出",
  "type": "object",
  "required": ["ok", "data"],
  "properties": {
    "ok": { "const": true },
    "data": {
      "type": "object",
      "required": ["name", "version", "workspace_root"],
      "properties": {
        "name": { "const": "tts" },
        "version": { "type": "string", "minLength": 1 },
        "workspace_root": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
