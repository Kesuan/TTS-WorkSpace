{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tts-workspace.dev/schemas/cli/synth.schema.json",
  "title": "tts synth --json 成功输出",
  "type": "object",
  "required": ["ok", "data"],
  "properties": {
    "ok": { "const": true },
    "data": {
      "type": "object",
      "required": [
        "output",
        "model",
        "voice",
        "chars",
        "duration_ms",
        "latency_ms",
        "cached",
        "cache_key",
        "sample_rate",
        "stream",
        "line_id",
        "take_id"
      ],
      "properties": {
        "output": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "voice": { "type": "string", "minLength": 1 },
        "chars": { "type": "integer", "minimum": 0 },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "latency_ms": { "type": "integer", "minimum": 0 },
        "cached": { "type": "boolean" },
        "cache_key": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
        "sample_rate": { "type": "integer", "minimum": 1 },
        "stream": { "type": "boolean" },
        "line_id": { "type": ["string", "null"] },
        "take_id": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
