{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tts-workspace.dev/schemas/cli/line-set.schema.json",
  "title": "tts line set --json 成功输出",
  "type": "object",
  "required": ["ok", "data"],
  "properties": {
    "ok": { "const": true },
    "data": {
      "type": "object",
      "required": ["project", "line_id", "overrides", "status"],
      "properties": {
        "project": { "type": "string", "minLength": 1 },
        "line_id": { "type": "string", "minLength": 1 },
        "overrides": {
          "type": "object",
          "required": ["voice", "style"],
          "properties": {
            "voice": { "type": ["string", "null"] },
            "style": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        },
        "status": { "enum": ["pending", "ok", "failed", "removed"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
