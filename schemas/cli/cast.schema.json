{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tts-workspace.dev/schemas/cli/cast.schema.json",
  "title": "tts cast --json 成功输出",
  "type": "object",
  "required": ["ok", "data"],
  "properties": {
    "ok": { "const": true },
    "data": {
      "type": "object",
      "required": ["project", "line_id", "text", "results"],
      "properties": {
        "project": { "type": "string", "minLength": 1 },
        "line_id": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["voice", "take_id", "file", "duration_ms", "latency_ms", "cached"],
            "properties": {
              "voice": { "type": "string", "minLength": 1 },
              "take_id": { "type": "string", "minLength": 1 },
              "file": { "type": "string", "minLength": 1 },
              "duration_ms": { "type": "integer", "minimum": 0 },
              "latency_ms": { "type": "integer", "minimum": 0 },
              "cached": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
